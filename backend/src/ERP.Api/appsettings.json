{
  "Product": { "Name": "ERP" },
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=ERP;User Id=sa;Password=__SET_VIA_ENV__;TrustServerCertificate=True"
  },
  "Database": { "AutoMigrate": false },
  "Auth": {
    "TwoFactor": { "Enforce": true, "Issuer": "ERP", "ChallengeMinutes": 10 },
    "SigningKey": "",
    "Issuer": "erp-api",
    "Audience": "erp-web",
    "AccessTokenMinutes": 5,
    "PersistentRefreshDays": 30,
    "SessionRefreshHours": 12,
    "SecureCookies": true,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "ResetTokenMinutes": 30
  },
  "Onboarding": { "AllowSelfSignup": false },
  "Platform": {
    "_comment": "The owner of this deployment. Set FounderEmail to make that account the platform owner. FounderPassword is only used to create the account the first time: set it through environment variables or user-secrets, then remove it.",
    "FounderEmail": "",
    "FounderPassword": "",
    "FounderName": "Founder",
    "CompanyName": "Platform HQ",
    "CountryCode": "AE",
    "BaseCurrency": "AED"
  },
  "Seed": { "Enabled": false },
  "Storage": { "Root": "storage" },
  "Cors": { "Origins": [ "http://localhost:4200" ] },
  "RateLimiting": { "LoginPerMinute": 10 },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } }
  },
  "AllowedHosts": "*"
}
